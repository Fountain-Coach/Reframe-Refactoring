#!/bin/sh
set -eu

mode="${1:---check}"
integration_root="${2:-}"

if [ -z "$integration_root" ]; then
  echo "usage: $0 [--check|--pull|--push] /path/to/midi2-gpu-fabric" >&2
  exit 2
fi

case "$integration_root" in
  /*) ;;
  *)
    echo "integration checkout must be an absolute path" >&2
    exit 2
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
publication_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
publication_docs="$publication_root/docs"
integration_docs="$integration_root/apps/modernization-studio/docs/reframe-grounding-first-refactor"

if [ ! -f "$publication_docs/00-abstract.md" ] || [ ! -f "$publication_docs/09-compatibility-and-future-evolution.md" ]; then
  echo "publication guide markers are missing: $publication_docs" >&2
  exit 2
fi

if [ ! -f "$integration_docs/00-abstract.md" ] || [ ! -f "$integration_docs/09-compatibility-and-future-evolution.md" ]; then
  echo "integration guide markers are missing: $integration_docs" >&2
  exit 2
fi

case "$mode" in
  --check)
    if diff -ru -x '._*' -x '.DS_Store' "$publication_docs" "$integration_docs"; then
      echo "guide copies are synchronized"
    else
      echo "guide copies differ" >&2
      exit 1
    fi
    ;;
  --pull)
    rsync --archive --delete --exclude '._*' --exclude '.DS_Store' "$integration_docs/" "$publication_docs/"
    echo "pulled integration guide into publication repository"
    ;;
  --push)
    rsync --archive --delete --exclude '._*' --exclude '.DS_Store' "$publication_docs/" "$integration_docs/"
    echo "pushed publication guide into integration checkout"
    ;;
  *)
    echo "unknown mode: $mode" >&2
    exit 2
    ;;
esac
